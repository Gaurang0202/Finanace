# Rename this file to .env and fill in real values. Never commit the real .env.

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
# Leave DATABASE_URL unset/commented to use the built-in local SQLite file
# (config.py points it at <project_root>/database/finance.db automatically).
# DATABASE_URL=sqlite:////absolute/path/to/database/finance.db
#
# To use PostgreSQL instead, uncomment and edit:
# DATABASE_URL=postgresql+psycopg://finance_user:finance_pass@localhost:5432/finance_db

# Mail (optional - used for password reset / monthly report emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

# Admin bootstrap account (created automatically on first run if it doesn't exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
